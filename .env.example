# ============================================================
# 超星学习通签到 — 环境变量配置模板
# 复制此文件为 .env 并填写实际值（.env 不会被提交到 Git）
# ============================================================

# --------- 超星账号 ---------
CHAOXING_PHONE=your_phone_number
CHAOXING_PASSWORD=your_password

# --------- 默认签到位置 ---------
location__longitude=116.404
location__latitude=39.915
location__name=北京市

# --------- MySQL 数据库 ---------
database__host=localhost
database__port=3306
database__user=root
database__password=your_db_password
database__database=chaoxing_sign

# --------- JWT ---------
jwt_secret=change-this-to-a-random-secret-string

# --------- 高德地图 API ---------
amap_key=your_amap_web_js_key
amap_key_info=your_amap_web_service_key
amap_version=2.0

# --------- 腾讯地图 API ---------
tmap_key=your_tencent_map_key

# --------- 签到 显示三角定位开关---------
sign__show_trilateration=true